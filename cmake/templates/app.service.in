[Unit]
Description=@APP_DISPLAY_NAME@
After=multi-user.target
# The store rejects services that run as root: uncomment and set a non-root
# account before you enable this unit.
#User=pi

[Service]
Type=simple
ExecStart=/usr/bin/@PROJECT_NAME@
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
